{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["site/*.js", "scripts/*.js", "types/*.d.ts", "*.config.ts", "eslint.config.js"]
}
